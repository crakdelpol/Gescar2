# ─────────────────────────────────────────────────────────────────────────────
# TEMPLATE per .env.local  –  COPIA questo file in .env.local e personalizzalo
# .env.local NON viene mai committato (è in .gitignore)
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=dev

# Genera un secret con: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=SOSTITUISCI_CON_32_CARATTERI_CASUALI

# ── Con Docker (docker-compose.yml) ──────────────────────────────────────────
DATABASE_URL="mysql://gescar_user:gescar_pass@127.0.0.1:3306/gescar?serverVersion=8.0&charset=utf8mb4"

# ── Mailer (Mailpit locale via Docker) ───────────────────────────────────────
MAILER_DSN=smtp://localhost:1025
