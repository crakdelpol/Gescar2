# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SECRET
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Sovrascrivere in .env.local con le credenziali reali del proprio ambiente.
# Generare le credenziali reali e non riutilizzare mai quelle di sviluppo in produzione.
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/gescar?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Sviluppo: Mailpit su Docker (porta 1025) — nessuna email reale inviata.
# Produzione: sovrascrivere in .env.local con il DSN del provider SMTP reale.
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

###> app/centro ###
# Sovrascrivere in .env.local con i dati reali del centro.
CENTRO_NOME="Nome Centro Revisioni"
CENTRO_EMAIL_MITTENTE="noreply@example.com"
###< app/centro ###
