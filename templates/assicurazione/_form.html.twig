{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation', 'id': 'assicurazione-form'}}) }}
    <div class="row g-3">
        <div class="col-md-6">{{ form_row(form.dataScadenzaAssicurazione, {'attr': {'class': 'form-control'}}) }}</div>
        <div class="col-md-6">{{ form_row(form.vettura,                    {'attr': {'class': 'form-select'}}) }}</div>
        <div class="col-12">{{ form_row(form.note,                         {'attr': {'class': 'form-control', 'rows': '3'}}) }}</div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>{{ button_label|default('Salva') }}
        </button>
        <a href="{{ path('app_assicurazione_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg me-1"></i>Annulla
        </a>
    </div>
{{ form_end(form) }}

<script>
(function () {
    'use strict';
    var form = document.getElementById('assicurazione-form');
    if (!form) return;
    form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
        }
        form.classList.add('was-validated');
    }, false);
})();
</script>
