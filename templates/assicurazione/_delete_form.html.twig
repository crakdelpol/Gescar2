<form method="post" action="{{ path('app_assicurazione_delete', {'id': assicurazione.id}) }}"
      onsubmit="return confirm('Eliminare definitivamente questa assicurazione? L\'operazione non è reversibile.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assicurazione.id) }}">
    <button class="btn btn-sm btn-danger">
        <i class="bi bi-trash me-1"></i>Elimina assicurazione
    </button>
</form>
