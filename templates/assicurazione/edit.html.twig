{% extends 'base.html.twig' %}

{% block title %}Modifica Assicurazione – Gescar{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="bi bi-pencil me-2"></i>Modifica assicurazione</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('app_assicurazione_show', {'id': assicurazione.id}) }}" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Dettaglio
        </a>
        <a href="{{ path('app_assicurazione_index') }}" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-shield-check me-1"></i>Lista
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        {{ include('assicurazione/_form.html.twig', {'button_label': 'Aggiorna'}) }}
    </div>
</div>

<hr>
{{ include('assicurazione/_delete_form.html.twig') }}
{% endblock %}
