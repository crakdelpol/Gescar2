{% extends 'base.html.twig' %}

{% block title %}Assicurazioni – Gescar{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="bi bi-shield-check me-2"></i>Assicurazioni</h1>
    <a href="{{ path('app_assicurazione_new') }}" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Nuova assicurazione
    </a>
</div>

<div class="table-responsive small">
    <table class="table table-striped table-hover table-sm align-middle">
        <thead class="table-dark">
            <tr>
                <th>Veicolo</th>
                <th>Intestatario</th>
                <th>Scad. Assicurazione</th>
                <th class="text-end">Azioni</th>
            </tr>
        </thead>
        <tbody>
        {% set oggi = "now"|date("Y-m-d") %}
        {% for assicurazione in assicuraziones %}
            <tr>
                <td>
                    {% if assicurazione.vettura %}
                        <a href="{{ path('app_vettura_show', {'id': assicurazione.vettura.id}) }}" class="text-decoration-none fw-semibold">
                            {{ assicurazione.vettura.targa ?: '–' }}
                        </a>
                        <span class="text-muted ms-1">{{ assicurazione.vettura.marca }} {{ assicurazione.vettura.modello }}</span>
                    {% else %}–{% endif %}
                </td>
                <td>
                    {% if assicurazione.vettura and assicurazione.vettura.intestatario %}
                        <a href="{{ path('app_anagrafica_show', {'id': assicurazione.vettura.intestatario.id}) }}" class="text-decoration-none">
                            {{ assicurazione.vettura.intestatario.cognome | capitalize }} {{ assicurazione.vettura.intestatario.nome | capitalize }}
                        </a>
                    {% else %}–{% endif %}
                </td>
                <td>
                    {% if assicurazione.dataScadenzaAssicurazione %}
                        {% set scad = assicurazione.dataScadenzaAssicurazione|date("Y-m-d") %}
                        {% if scad < oggi %}
                            <span class="badge bg-danger">{{ assicurazione.dataScadenzaAssicurazione|date('d/m/Y') }}</span>
                        {% elseif scad < ("now +30 days")|date("Y-m-d") %}
                            <span class="badge bg-warning text-dark">{{ assicurazione.dataScadenzaAssicurazione|date('d/m/Y') }}</span>
                        {% else %}
                            <span class="text-muted">{{ assicurazione.dataScadenzaAssicurazione|date('d/m/Y') }}</span>
                        {% endif %}
                    {% else %}<span class="text-muted">–</span>{% endif %}
                </td>
                <td class="text-end text-nowrap">
                    <a href="{{ path('app_assicurazione_show', {'id': assicurazione.id}) }}" class="btn btn-sm btn-outline-secondary" title="Visualizza">
                        <i class="bi bi-eye"></i>
                    </a>
                    <a href="{{ path('app_assicurazione_edit', {'id': assicurazione.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifica">
                        <i class="bi bi-pencil"></i>
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center text-muted py-4">
                    <i class="bi bi-shield-check me-2"></i>Nessuna assicurazione trovata.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
