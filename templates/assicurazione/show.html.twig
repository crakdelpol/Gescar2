{% extends 'base.html.twig' %}

{% block title %}Assicurazione – Gescar{% endblock %}

{% block body %}
{% set oggi = "now"|date("Y-m-d") %}
<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        <i class="bi bi-shield-check me-2 text-secondary"></i>Assicurazione
        {% if assicurazione.dataScadenzaAssicurazione %}
            {% set scad = assicurazione.dataScadenzaAssicurazione|date("Y-m-d") %}
            {% if scad < oggi %}
                <span class="badge bg-danger ms-2">{{ assicurazione.dataScadenzaAssicurazione|date('d/m/Y') }}</span>
            {% elseif scad < ("now +30 days")|date("Y-m-d") %}
                <span class="badge bg-warning text-dark ms-2">{{ assicurazione.dataScadenzaAssicurazione|date('d/m/Y') }}</span>
            {% else %}
                <span class="badge bg-success ms-2">{{ assicurazione.dataScadenzaAssicurazione|date('d/m/Y') }}</span>
            {% endif %}
        {% endif %}
    </h1>
    <div class="d-flex gap-2">
        <a href="{{ path('app_assicurazione_index') }}" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Lista
        </a>
        <a href="{{ path('app_assicurazione_edit', {'id': assicurazione.id}) }}" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-pencil me-1"></i>Modifica
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">
                <i class="bi bi-shield-check me-1"></i>Dati assicurazione
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted">Scadenza</dt>
                    <dd class="col-sm-7">
                        {% if assicurazione.dataScadenzaAssicurazione %}
                            {% set scad = assicurazione.dataScadenzaAssicurazione|date("Y-m-d") %}
                            {% if scad < oggi %}
                                <span class="badge bg-danger">{{ assicurazione.dataScadenzaAssicurazione|date('d/m/Y') }}</span>
                            {% elseif scad < ("now +30 days")|date("Y-m-d") %}
                                <span class="badge bg-warning text-dark">{{ assicurazione.dataScadenzaAssicurazione|date('d/m/Y') }}</span>
                            {% else %}
                                <span class="badge bg-success">{{ assicurazione.dataScadenzaAssicurazione|date('d/m/Y') }}</span>
                            {% endif %}
                        {% else %}–{% endif %}
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    {% if assicurazione.vettura %}
    <div class="col-md-6">
        <div class="card h-100 border-start border-warning border-3">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-car-front fs-4 text-warning"></i>
                <div>
                    <span class="text-muted small">Veicolo</span><br>
                    <a href="{{ path('app_vettura_show', {'id': assicurazione.vettura.id}) }}" class="fw-semibold text-decoration-none">
                        {{ assicurazione.vettura.targa ?: '–' }}
                    </a>
                    {% if assicurazione.vettura.marca or assicurazione.vettura.modello %}
                        <span class="text-muted ms-1">{{ assicurazione.vettura.marca }} {{ assicurazione.vettura.modello }}</span>
                    {% endif %}
                    {% if assicurazione.vettura.intestatario %}
                        <br><small class="text-muted">
                            <a href="{{ path('app_anagrafica_show', {'id': assicurazione.vettura.intestatario.id}) }}" class="text-decoration-none text-muted">
                                {{ assicurazione.vettura.intestatario.cognome | capitalize }} {{ assicurazione.vettura.intestatario.nome | capitalize }}
                            </a>
                        </small>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {% if assicurazione.note %}
    <div class="col-12">
        <div class="alert alert-light border d-flex align-items-start gap-2 mb-0">
            <i class="bi bi-sticky text-warning mt-1"></i>
            <span>{{ assicurazione.note }}</span>
        </div>
    </div>
    {% endif %}
</div>

<hr>
<div class="d-flex align-items-center gap-2">
    {{ include('assicurazione/_delete_form.html.twig') }}
</div>
{% endblock %}
