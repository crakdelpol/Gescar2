{% extends 'base.html.twig' %}

{% block title %}Assicurazione{% endblock %}

{% block body %}
    <h1>Assicurazione</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ assicurazione.id }}</td>
            </tr>
            <tr>
                <th>DataScadenzaAssicurazione</th>
                <td>{{ assicurazione.dataScadenzaAssicurazione ? assicurazione.dataScadenzaAssicurazione|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Note</th>
                <td>{{ assicurazione.note }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_assicurazione_index') }}">back to list</a>

    <a href="{{ path('app_assicurazione_edit', {'id': assicurazione.id}) }}">edit</a>

    {{ include('assicurazione/_delete_form.html.twig') }}
{% endblock %}
