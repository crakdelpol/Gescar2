<form method="post" action="{{ path('app_bollo_delete', {'id': bollo.id}) }}"
      onsubmit="return confirm('Eliminare definitivamente questo bollo? L\'operazione non è reversibile.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bollo.id) }}">
    <button class="btn btn-sm btn-danger">
        <i class="bi bi-trash me-1"></i>Elimina bollo
    </button>
</form>
