{# ── Patenti ────────────────────────────────────────────────────────────── #}
<div class="d-flex align-items-center gap-2 mb-2" id="sez-patenti">
    <h5 class="mb-0"><i class="bi bi-card-text text-secondary me-1"></i>Patenti</h5>
    {% if patenti is not empty %}
        <span class="badge bg-secondary">{{ patenti|length }}</span>
    {% else %}
        <span class="badge bg-success">0</span>
    {% endif %}
</div>
{% if patenti is empty %}
    <p class="text-muted small mb-4"><i class="bi bi-check-circle me-1 text-success"></i>Nessuna patente nel periodo selezionato.</p>
{% else %}
<div class="table-responsive mb-4">
    <table class="table table-sm table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Cliente</th>
                <th>Telefono</th>
                <th>N° Patente</th>
                <th>Categorie</th>
                <th>Scadenza</th>
                <th>Note</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for p in patenti %}
            <tr>
                <td>
                    <a href="{{ path('app_anagrafica_show', {id: p.intestatario.id}) }}">
                        {{ p.intestatario.cognome|capitalize }} {{ p.intestatario.nome|capitalize }}
                    </a>
                </td>
                <td>{{ p.intestatario.telefono }}</td>
                <td>{{ p.numeroPatente }}</td>
                <td>{{ p.categoriaPatente ? p.categoriaPatente|join(', ') : '–' }}</td>
                <td>{{ macro.badge_scadenza(p.dataScadenzaPatente, scadenzaService) }}</td>
                <td>{{ p.note }}</td>
