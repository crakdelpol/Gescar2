{# ── Bolli ──────────────────────────────────────────────────────────────── #}
<div class="d-flex align-items-center gap-2 mb-2" id="sez-bolli">
    <h5 class="mb-0"><i class="bi bi-receipt text-info me-1"></i>Bolli</h5>
