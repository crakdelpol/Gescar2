                    <a class="btn btn-sm btn-outline-secondary"
                       href="{{ path('app_patente_edit', {id: p.id}) }}" title="Modifica">
                        <i class="bi bi-pencil"></i>
                    </a>
                    {{ macro.azioni_notifica(
                        p.intestatario.id, 'patente',
                        p.dataScadenzaPatente ? p.dataScadenzaPatente|date('Y-m-d') : '',
