{% block javascripts %}
<script>
// ── WhatsApp: validazione numero + apertura wa.me ─────────────────────────
function normalizzaTelefono(raw) {
    // Rimuove spazi, trattini, punti, parentesi
    let tel = raw.replace(/[\s\-\.\(\)\/]/g, '');
    // Gestisce prefissi già presenti
    if (tel.startsWith('0039'))     tel = '+39' + tel.slice(4);
    else if (tel.startsWith('39') && !tel.startsWith('+')) tel = '+39' + tel.slice(2);
    else if (!tel.startsWith('+')) tel = '+39' + tel;
    // Valida: +39 seguito da 9-10 cifre
    return /^\+39\d{9,10}$/.test(tel) ? tel : null;
}

function inviaWhatsApp(btn) {
    const anaId = btn.dataset.waAna;
    const tipo  = btn.dataset.waTipo;
    const data  = btn.dataset.waData;
    const targa = btn.dataset.waTarga || '';

    // Recupera il telefono dalla cella della stessa riga (2a colonna, indice 1)
    const row   = btn.closest('tr');
    const raw   = row ? (row.cells[1]?.textContent?.trim() ?? '') : '';

    if (!raw) {
        alert('Nessun numero di telefono registrato per questo cliente.\nAggiornalo nell\'anagrafica.');
        return;
    }

    const numero = normalizzaTelefono(raw);
    if (!numero) {
        alert(
            'Il numero "' + raw + '" non è valido.\n\n' +
            'Il formato corretto è: 333 123 4567 oppure +39 333 123 4567\n\n' +
            'Correggi il telefono nell\'anagrafica del cliente e riprova.'
        );
        return;
    }

    // Chiama il server per generare l\'URL e registrare la notifica
    const url = '{{ path('app_notifica_invia_whatsapp') }}'
        + '?anaId=' + encodeURIComponent(anaId)
        + '&tipo='  + encodeURIComponent(tipo)
        + '&data='  + encodeURIComponent(data)
        + '&targa=' + encodeURIComponent(targa);

    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(json => {
            if (json.error) {
                alert('Errore: ' + json.error);
            } else {
                window.open(json.url, '_blank');
                // Feedback visivo: colora brevemente il bottone
                btn.classList.replace('btn-success', 'btn-outline-success');
                setTimeout(() => btn.classList.replace('btn-outline-success', 'btn-success'), 3000);
            }
        })
        .catch(() => alert('Errore di rete. Riprova.'));
}

// ── Helper date ──────────────────────────────────────────────────────────
function today() {
    return new Date().toISOString().split('T')[0];
}
function addDays(n) {
    const d = new Date();
    d.setDate(d.getDate() + n);
    return d.toISOString().split('T')[0];
}
function firstDayOfMonth() {
    const d = new Date();
    return new Date(d.getFullYear(), d.getMonth(), 1).toISOString().split('T')[0];
}
function lastDayOfMonth() {
    const d = new Date();
    return new Date(d.getFullYear(), d.getMonth() + 1, 0).toISOString().split('T')[0];
}

// ── Pulsanti scorciatoia: imposta date e fa submit ───────────────────────
function quickFilter(da, a) {
    document.getElementById('input-da').value = da;
    document.getElementById('input-a').value  = a;
    document.getElementById('filtro-form').submit();
}

// ── Click su card semaforo: scrolla alla sezione corrispondente ───────────
function activateTab(tabId) {
    const map = {
        'tab-revisioni':     'sez-revisioni',
        'tab-assicurazioni': 'sez-assicurazioni',
        'tab-bolli':         'sez-bolli',
        'tab-patenti':       'sez-patenti',
    };
    const el = document.getElementById(map[tabId] ?? tabId);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ── Hover sulle card semaforo ────────────────────────────────────────────
document.querySelectorAll('.semaforo-card').forEach(card => {
    card.style.cursor = 'pointer';
    card.addEventListener('mouseenter', () => card.classList.add('shadow'));
    card.addEventListener('mouseleave', () => card.classList.remove('shadow'));
});
</script>
{% endblock %}
