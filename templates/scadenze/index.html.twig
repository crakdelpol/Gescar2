{% extends 'base.html.twig' %}
{% block title %}Scadenze – Gescar{% endblock %}

{% block body %}

{# ── Macro badge semaforo ──────────────────────────────────────────────── #}
{% macro badge_scadenza(data, scadenzaService) %}
    {% if data is null %}
        <span class="badge bg-secondary">N/D</span>
    {% else %}
        {% set stato = scadenzaService.calcolaStato(data) %}
        {% set map = {'scaduto':'danger','in_scadenza':'warning','in_avvicinamento':'info','ok':'success','non_definito':'secondary'} %}
        <span class="badge bg-{{ map[stato] ?? 'secondary' }}">{{ data|date('d/m/Y') }}</span>
    {% endif %}
{% endmacro %}
{% import _self as macro %}

{# ── Macro pulsanti azione notifica ────────────────────────────────────── #}
{% macro azioni_notifica(anaId, tipo, dataYmd, targa, email) %}
    {# WhatsApp — validazione e apertura wa.me gestite da JS #}
    <button type="button" class="btn btn-sm btn-success"
            data-wa-ana="{{ anaId }}"
            data-wa-tipo="{{ tipo }}"
            data-wa-data="{{ dataYmd }}"
            data-wa-targa="{{ targa }}"
            onclick="inviaWhatsApp(this)"
            title="Invia WhatsApp">
        <i class="bi bi-whatsapp"></i>
    </button>
    {# Email — form POST, redirect con flash #}
    {% if email %}
    <form method="post" action="{{ path('app_notifica_invia_email') }}" class="d-inline ms-1">
        <input type="hidden" name="anaId"   value="{{ anaId }}">
        <input type="hidden" name="tipo"    value="{{ tipo }}">
        <input type="hidden" name="data"    value="{{ dataYmd }}">
        <input type="hidden" name="targa"   value="{{ targa }}">
        <input type="hidden" name="_token"  value="{{ csrf_token('notifica_email') }}">
        <input type="hidden" name="_ref"    value="{{ app.request.uri }}">
        <button type="submit" class="btn btn-sm btn-outline-primary" title="Invia email a {{ email }}">
            <i class="bi bi-envelope"></i>
        </button>
    </form>
    {% else %}
    <button type="button" class="btn btn-sm btn-outline-secondary ms-1 disabled"
            title="Nessuna email registrata per questo cliente">
        <i class="bi bi-envelope-x"></i>
    </button>
    {% endif %}
{% endmacro %}

{# ── Intestazione ──────────────────────────────────────────────────────── #}
<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2 mb-0">
        <i class="bi bi-calendar-event me-2 text-primary"></i>Scadenze
    </h1>
    <small class="text-muted">Aggiornato al {{ 'now'|date('d/m/Y H:i') }}</small>
</div>

{# ═══════════════════════════════════════════════════════════════════════════
   SEZIONE 1 — SEMAFORO (dati fissi di oggi, indipendenti dal filtro)
   ═══════════════════════════════════════════════════════════════════════════ #}
<div class="row g-2 mb-4">

    {% set n = sommario.revisioni_scadute|length %}
    <div class="col-6 col-md">
        <div class="card h-100 border-{{ n > 0 ? 'danger' : 'success' }} shadow-sm semaforo-card"
             role="button" onclick="activateTab('tab-revisioni')" title="Filtra revisioni">
            <div class="card-body text-center py-2 px-1">
                <div class="display-6 fw-bold text-{{ n > 0 ? 'danger' : 'success' }}">{{ n }}</div>
                <div class="small text-muted lh-sm mt-1">Revisioni<br>scadute</div>
                {% if n > 0 %}
                    <i class="bi bi-exclamation-triangle-fill text-danger small"></i>
                {% else %}
                    <i class="bi bi-check-circle-fill text-success small"></i>
                {% endif %}
            </div>
        </div>
    </div>

    {% set n = sommario.revisioni_30gg|length %}
    <div class="col-6 col-md">
        <div class="card h-100 border-{{ n > 0 ? 'warning' : 'success' }} shadow-sm semaforo-card"
             role="button" onclick="activateTab('tab-revisioni')" title="Filtra revisioni">
            <div class="card-body text-center py-2 px-1">
                <div class="display-6 fw-bold text-{{ n > 0 ? 'warning' : 'success' }}">{{ n }}</div>
                <div class="small text-muted lh-sm mt-1">Revisioni<br>entro 30 gg</div>
            </div>
        </div>
    </div>

    {% set n = sommario.assicurazioni_30gg|length %}
    <div class="col-6 col-md">
        <div class="card h-100 border-{{ n > 0 ? 'warning' : 'success' }} shadow-sm semaforo-card"
             role="button" onclick="activateTab('tab-assicurazioni')" title="Filtra assicurazioni">
            <div class="card-body text-center py-2 px-1">
                <div class="display-6 fw-bold text-{{ n > 0 ? 'warning' : 'success' }}">{{ n }}</div>
                <div class="small text-muted lh-sm mt-1">Assicurazioni<br>entro 30 gg</div>
            </div>
        </div>
    </div>

    {% set n = sommario.patenti_60gg|length %}
    <div class="col-6 col-md">
        <div class="card h-100 border-{{ n > 0 ? 'info' : 'success' }} shadow-sm semaforo-card"
             role="button" onclick="activateTab('tab-patenti')" title="Filtra patenti">
            <div class="card-body text-center py-2 px-1">
                <div class="display-6 fw-bold text-{{ n > 0 ? 'info' : 'success' }}">{{ n }}</div>
                <div class="small text-muted lh-sm mt-1">Patenti<br>entro 60 gg</div>
            </div>
        </div>
    </div>

    {% set n = sommario.bolli_mese_corrente|length %}
    <div class="col-6 col-md">
        <div class="card h-100 border-{{ n > 0 ? 'info' : 'success' }} shadow-sm semaforo-card"
             role="button" onclick="activateTab('tab-bolli')" title="Filtra bolli">
            <div class="card-body text-center py-2 px-1">
                <div class="display-6 fw-bold text-{{ n > 0 ? 'info' : 'success' }}">{{ n }}</div>
                <div class="small text-muted lh-sm mt-1">Bolli<br>questo mese</div>
            </div>
        </div>
    </div>

</div>

{# ═══════════════════════════════════════════════════════════════════════════
   SEZIONE 2 — FILTRO DATE + SCORCIATOIE
   ═══════════════════════════════════════════════════════════════════════════ #}
<div class="card mb-3 border-0 bg-body-tertiary">
    <div class="card-body py-2 px-3">

        {{ form_start(search_form, {attr: {class: 'row g-2 align-items-end', id: 'filtro-form'}}) }}
            <div class="col-auto">
                {{ form_label(search_form.dataScadenza, 'Da', {label_attr: {class: 'form-label mb-1 small'}}) }}
                {{ form_widget(search_form.dataScadenza, {attr: {class: 'form-control form-control-sm', id: 'input-da'}}) }}
            </div>
            <div class="col-auto">
                {{ form_label(search_form.aDataScadenza, 'A', {label_attr: {class: 'form-label mb-1 small'}}) }}
                {{ form_widget(search_form.aDataScadenza, {attr: {class: 'form-control form-control-sm', id: 'input-a'}}) }}
            </div>
            <div class="col-auto align-self-end">
                {{ form_widget(search_form.cerca, {attr: {class: 'btn btn-primary btn-sm'}}) }}
            </div>
            <div class="col-auto align-self-end">
                <span class="badge text-bg-secondary fs-6 px-3 py-2">
                    <i class="bi bi-calendar-range me-1"></i>
                    {{ dataScadenza|date('d/m/Y') }} → {{ aDataScadenza|date('d/m/Y') }}
                </span>
            </div>
        {{ form_end(search_form) }}

        {# PULSANTI RAPIDI — decommentare quando richiesto dal cliente
        <div class="mt-2 d-flex flex-wrap gap-1">
            <button type="button" class="btn btn-outline-danger btn-sm"
                    onclick="quickFilter('1970-01-01', today())">
                <i class="bi bi-exclamation-triangle me-1"></i>Scaduti
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    onclick="quickFilter(today(), today())">Oggi</button>
            <button type="button" class="btn btn-outline-warning btn-sm"
                    onclick="quickFilter(today(), addDays(30))">+30 gg</button>
            <button type="button" class="btn btn-outline-info btn-sm"
                    onclick="quickFilter(today(), addDays(60))">+60 gg</button>
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    onclick="quickFilter(firstDayOfMonth(), lastDayOfMonth())">Questo mese</button>
        </div>
        #}

    </div>
</div>

{# ═══════════════════════════════════════════════════════════════════════════
   SEZIONE 3 — RISULTATI
   ═══════════════════════════════════════════════════════════════════════════ #}

{# ── Revisioni ─────────────────────────────────────────────────────────── #}
<div class="d-flex align-items-center gap-2 mb-2" id="sez-revisioni">
    <h5 class="mb-0"><i class="bi bi-wrench text-danger me-1"></i>Revisioni</h5>
    {% if vetture is not empty %}
        <span class="badge bg-danger">{{ vetture|length }}</span>
    {% else %}
        <span class="badge bg-success">0</span>
    {% endif %}
</div>
{% if vetture is empty %}
    <p class="text-muted small mb-4"><i class="bi bi-check-circle me-1 text-success"></i>Nessuna revisione nel periodo selezionato.</p>
{% else %}
<div class="table-responsive mb-4">
    <table class="table table-sm table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Cliente</th>
                <th>Telefono</th>
                <th>Targa</th>
                <th>Marca / Modello</th>
                <th>Scadenza</th>
                <th>Note</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for v in vetture %}
            <tr>
                <td>
                    <a href="{{ path('app_anagrafica_show', {id: v.intestatario.id}) }}">
                        {{ v.intestatario.cognome|capitalize }} {{ v.intestatario.nome|capitalize }}
                    </a>
                </td>
                <td>{{ v.intestatario.telefono }}</td>
                <td><code>{{ v.targa }}</code></td>
                <td>{{ v.marca }} {{ v.modello }}</td>
                <td>{{ macro.badge_scadenza(v.dataScadenzaRevisione, scadenzaService) }}</td>
                <td class="text-truncate" style="max-width:160px">{{ v.note }}</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary"
                       href="{{ path('app_vettura_edit', {id: v.id}) }}" title="Modifica">
                        <i class="bi bi-pencil"></i>
                    </a>
                    {{ macro.azioni_notifica(
                        v.intestatario.id, 'revisione',
                        v.dataScadenzaRevisione ? v.dataScadenzaRevisione|date('Y-m-d') : '',
                        v.targa,
                        v.intestatario.email
                    ) }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

{# ── Assicurazioni ─────────────────────────────────────────────────────── #}
<div class="d-flex align-items-center gap-2 mb-2" id="sez-assicurazioni">
    <h5 class="mb-0"><i class="bi bi-shield-check text-warning me-1"></i>Assicurazioni</h5>
    {% if assicurazioni is not empty %}
        <span class="badge bg-warning text-dark">{{ assicurazioni|length }}</span>
    {% else %}
        <span class="badge bg-success">0</span>
    {% endif %}
</div>
{% if assicurazioni is empty %}
    <p class="text-muted small mb-4"><i class="bi bi-check-circle me-1 text-success"></i>Nessuna assicurazione nel periodo selezionato.</p>
{% else %}
<div class="table-responsive mb-4">
    <table class="table table-sm table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Cliente</th>
                <th>Telefono</th>
                <th>Targa</th>
                <th>Compagnia</th>
                <th>Scadenza</th>
                <th>Note</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for a in assicurazioni %}
