                <td>{{ a.note }}</td>
                <td class="text-nowrap">
                    {{ macro.azioni_notifica(
                        a.vettura.intestatario.id, 'assicurazione',
                        a.dataScadenzaAssicurazione ? a.dataScadenzaAssicurazione|date('Y-m-d') : '',
