                <td>{{ b.vettura.intestatario.telefono }}</td>
                <td><code>{{ b.vettura.targa }}</code></td>
                <td>{{ b.vettura.tipo }}</td>
                <td>{{ b.importo ? '€ ' ~ b.importo : '–' }}</td>
                <td>{{ macro.badge_scadenza(b.dataScadenzaBollo, scadenzaService) }}</td>
                <td>{{ b.note }}</td>
                <td class="text-nowrap">
                    {{ macro.azioni_notifica(
                        b.vettura.intestatario.id, 'bollo',
                        b.dataScadenzaBollo ? b.dataScadenzaBollo|date('Y-m-d') : '',
                        b.vettura.targa,
                        b.vettura.intestatario.email
                    ) }}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
