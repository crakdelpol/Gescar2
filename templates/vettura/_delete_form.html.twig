<form method="post" action="{{ path('app_vettura_delete', {'id': vettura.id}) }}"
      onsubmit="return confirm('Eliminare definitivamente questo veicolo? L\'operazione non è reversibile.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vettura.id) }}">
    <button class="btn btn-sm btn-danger">
        <i class="bi bi-trash me-1"></i>Elimina veicolo
    </button>
</form>
