<!DOCTYPE html>
<html lang="it" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Gescar – Centro Revisioni{% endblock %}</title>

    {# Bootstrap 5.3 + Bootstrap Icons (CDN) #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/custom.css') }}">
    {% endblock %}

    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
    <style>
        /* Layout sidebar fisso su desktop */
        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 56px 0 0;
            box-shadow: inset -1px 0 0 rgba(0,0,0,.1);
            width: 220px;
        }
        .sidebar .nav-link {
            font-size: .9rem;
            color: #333;
            padding: .4rem 1rem;
        }
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: rgba(0,0,0,.05);
            color: #0d6efd;
        }
        .sidebar .nav-link i {
            margin-right: .4rem;
            width: 18px;
            text-align: center;
        }
        .main-content {
            margin-left: 220px;
            padding: 1rem 1.5rem;
        }
        @media (max-width: 767.98px) {
            .sidebar { display: none; }
            .main-content { margin-left: 0; }
        }
        .navbar-brand img { height: 36px; }
    </style>
</head>
<body>

{# ── Navbar superiore ─────────────────────────────────────────────────── #}
<nav class="navbar navbar-dark bg-dark fixed-top px-3 py-1">
    <a class="navbar-brand" href="{{ path('app_scadenze_home') }}">
        <img src="{{ asset('img/datee_logo.png') }}" alt="Gescar">
    </a>

    {# Ricerca rapida #}
    <form class="d-flex flex-grow-1 mx-3" action="{{ path('app_anagrafica_index') }}" method="get" style="max-width:400px">
        <div class="input-group input-group-sm">
            <input class="form-control" type="search" name="q" placeholder="Cerca cliente o targa…"
                   value="{{ app.request.query.get('q') }}" autocomplete="off">
            <button class="btn btn-outline-light" type="submit">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </form>

    {# Utente / logout #}
    {% if app.user %}
    <div class="dropdown">
        <button class="btn btn-sm btn-outline-light dropdown-toggle" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle me-1"></i>{{ app.user.userIdentifier }}
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                <i class="bi bi-box-arrow-right me-2"></i>Esci
            </a></li>
        </ul>
    </div>
    {% endif %}

    {# Toggle sidebar mobile #}
    <button class="navbar-toggler ms-2 d-md-none" type="button"
            data-bs-toggle="offcanvas" data-bs-target="#sidebarMobile">
        <span class="navbar-toggler-icon"></span>
    </button>
</nav>

{# ── Sidebar desktop ──────────────────────────────────────────────────── #}
<nav class="sidebar bg-body-tertiary d-none d-md-block">
    <div class="position-sticky pt-3">
        <p class="px-3 text-uppercase text-muted small fw-semibold mb-1" style="font-size:.7rem">Menu</p>
        <ul class="nav flex-column mb-3">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_scadenze_home') }}">
                    <i class="bi bi-calendar-event"></i> Scadenze
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_dashboard_index') }}">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_notifica_index') }}">
                    <i class="bi bi-bell"></i> Notifiche
                </a>
            </li>
        </ul>

        <p class="px-3 text-uppercase text-muted small fw-semibold mb-1" style="font-size:.7rem">Anagrafica</p>
        <ul class="nav flex-column mb-3">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_anagrafica_index') }}">
                    <i class="bi bi-people"></i> Clienti
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_vettura_index') }}">
                    <i class="bi bi-car-front"></i> Veicoli
                </a>
            </li>
        </ul>

        <p class="px-3 text-uppercase text-muted small fw-semibold mb-1" style="font-size:.7rem">Scadenze</p>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_assicurazione_index') }}">
                    <i class="bi bi-shield-check"></i> Assicurazioni
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_bollo_index') }}">
                    <i class="bi bi-receipt"></i> Bolli
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="{{ path('app_patente_index') }}">
                    <i class="bi bi-card-text"></i> Patenti
                </a>
            </li>
        </ul>
    </div>
</nav>

{# ── Sidebar mobile (offcanvas) ───────────────────────────────────────── #}
<div class="offcanvas offcanvas-start d-md-none" id="sidebarMobile" tabindex="-1">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Gescar</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="nav flex-column">
            <li><a class="nav-link" href="{{ path('app_scadenze_home') }}"><i class="bi bi-calendar-event me-2"></i>Scadenze</a></li>
            <li><a class="nav-link" href="{{ path('app_dashboard_index') }}"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
            <li><a class="nav-link" href="{{ path('app_notifica_index') }}"><i class="bi bi-bell me-2"></i>Notifiche</a></li>
            <li><hr class="my-1"></li>
            <li><a class="nav-link" href="{{ path('app_anagrafica_index') }}"><i class="bi bi-people me-2"></i>Clienti</a></li>
            <li><a class="nav-link" href="{{ path('app_vettura_index') }}"><i class="bi bi-car-front me-2"></i>Veicoli</a></li>
            <li><a class="nav-link" href="{{ path('app_assicurazione_index') }}"><i class="bi bi-shield-check me-2"></i>Assicurazioni</a></li>
            <li><a class="nav-link" href="{{ path('app_bollo_index') }}"><i class="bi bi-receipt me-2"></i>Bolli</a></li>
            <li><a class="nav-link" href="{{ path('app_patente_index') }}"><i class="bi bi-card-text me-2"></i>Patenti</a></li>
        </ul>
    </div>
</div>

{# ── Contenuto principale ─────────────────────────────────────────────── #}
<main class="main-content" style="margin-top:56px">
    {% for label, messages in app.flashes %}
        {% for msg in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : label) }} alert-dismissible mt-2" role="alert">
                {{ msg }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

{# Bootstrap 5.3 JS (bundle include Popper – NO jQuery) #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmAt5fD4JOf5b8bBIAFEKQqluZnX"
        crossorigin="anonymous"></script>

{% block javascripts %}{% endblock %}
</body>
</html>
