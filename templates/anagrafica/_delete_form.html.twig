<form method="post" action="{{ path('app_anagrafica_delete', {'id': anagrafica.id}) }}"
      onsubmit="return confirm('Eliminare definitivamente questo cliente? L\'operazione non è reversibile.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ anagrafica.id) }}">
    <button class="btn btn-sm btn-danger">
        <i class="bi bi-trash me-1"></i>Elimina cliente
    </button>
</form>
