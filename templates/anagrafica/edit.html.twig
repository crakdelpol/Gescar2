{% extends 'base.html.twig' %}

{% block title %}Modifica {{ anagrafica.cognome }} {{ anagrafica.nome }} – Anagrafica{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><i class="bi bi-pencil me-2"></i>Modifica cliente</h1>
    <div class="d-flex gap-2">
        <a href="{{ path('app_anagrafica_show', {'id': anagrafica.id}) }}" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Dettaglio
        </a>
        <a href="{{ path('app_anagrafica_index') }}" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-people me-1"></i>Lista
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        {{ include('anagrafica/_form.html.twig', {'button_label': 'Aggiorna'}) }}
    </div>
</div>

<hr>
{{ include('anagrafica/_delete_form.html.twig') }}
{% endblock %}
