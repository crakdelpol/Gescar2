{% extends 'base.html.twig' %}

{% block title %}Anagrafica{% endblock %}

{% block body %}
    <h1>Anagrafica</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ anagrafica.id }}</td>
            </tr>
            <tr>
                <th>Cliente</th>
                <td>{{ anagrafica.nome | capitalize }} {{ anagrafica.cognome | capitalize }}</td>
            </tr>
            <tr>
                <th>Telefono</th>
                <td>{{ anagrafica.telefono }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ anagrafica.email }}</td>
            </tr>
            <tr>
                <th>Tipo</th>
                <td>{{ anagrafica.tipo }}</td>
            </tr>
            <tr>
                <th>Residenza</th>
                <td>{{ anagrafica.residenza }}</td>
            </tr>
            <tr>
                <th>Sede Legale</th>
                <td>{{ anagrafica.sedeLegale }}</td>
            </tr>           
            <tr>
                <th>Codice fiscale</th>
                <td>{{ anagrafica.codiceFiscale }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_anagrafica_index') }}">back to list</a>

    <a href="{{ path('app_anagrafica_edit', {'id': anagrafica.id}) }}">edit</a>

    {{ include('anagrafica/_delete_form.html.twig') }}
{% endblock %}
