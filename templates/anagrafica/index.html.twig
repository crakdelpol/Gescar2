{% extends 'base.html.twig' %}

{% block title %}Anagrafica index{% endblock %}

{% block body %}
    <h1>Anagrafica</h1>

    <div class="table-responsive small">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Tipo</th>
                    <th>Telefono</th>
                    <th>Residenza</th>
                    <th>Sede Legale</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
                {% for cliente in anagrafiche %}
                    <tr>
                        <td>{{ cliente.nome | capitalize }} {{ cliente.cognome | capitalize }}</td>
                        <td>{{ cliente.tipo }}</td>
                        <td>{{ cliente.telefono }}</td>
                        <td>{{ cliente.residenza | capitalize }}</td>
                        <td>{{ cliente.sedeLegale | capitalize }}</td>
                        <td>
                            <a href="{{ path('app_anagrafica_show', {'id': cliente.id}) }}">show</a>
                            <a href="{{ path('app_anagrafica_edit', {'id': cliente.id}) }}">edit</a>
                        </td>
                    </tr>
                {% else %}
                <tr>
                    <td colspan="6">no records found</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>


         <a href="{{ path('app_anagrafica_new') }}">Create new</a>
    </div>

{% endblock %}