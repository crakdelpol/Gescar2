{{ form_start(form, {'attr': {'novalidate': 'novalidate', 'class': 'needs-validation', 'id': 'patente-form'}}) }}
    <div class="row g-3">
        <div class="col-md-4">{{ form_row(form.numeroPatente,      {'attr': {'class': 'form-control text-uppercase'}}) }}</div>
        <div class="col-md-4">{{ form_row(form.dataScadenzaPatente,{'attr': {'class': 'form-control'}}) }}</div>
        <div class="col-md-4">{{ form_row(form.intestatario,       {'attr': {'class': 'form-select'}}) }}</div>
        <div class="col-12">
            <fieldset class="border rounded p-3">
                <legend class="float-none w-auto px-2 small fw-semibold">Categorie patente</legend>
                {{ form_widget(form.categoriaPatente) }}
                {{ form_errors(form.categoriaPatente) }}
            </fieldset>
        </div>
        <div class="col-12">{{ form_row(form.note, {'attr': {'class': 'form-control', 'rows': '3'}}) }}</div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>{{ button_label|default('Salva') }}
        </button>
        <a href="{{ path('app_patente_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg me-1"></i>Annulla
        </a>
    </div>
{{ form_end(form) }}

<script>
(function () {
    'use strict';
    var form = document.getElementById('patente-form');
    if (!form) return;
    form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
        }
        form.classList.add('was-validated');
    }, false);
    var np = form.querySelector('.text-uppercase');
    if (np) np.addEventListener('input', function () { this.value = this.value.toUpperCase(); });
})();
</script>
